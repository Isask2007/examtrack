# ------------------------------------------------------------------
# ExamTrack environment variables
# Copy this file to ".env" and change the values for your machine.
# ------------------------------------------------------------------

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret-key

# MySQL connection settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=esrms

# Only used by STOP/START scripts to shut down the local MySQL server.
MYSQL_ROOT_PASSWORD=replace-with-your-local-root-password

# Optional: full SQLAlchemy URL. If set, the MYSQL_* values above are ignored.
# DATABASE_URL=mysql+pymysql://esrms_user:StrongPass%40123@localhost:3306/esrms?charset=utf8mb4

# Default admin account created by: flask --app app seed
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@esrms.local
ADMIN_PASSWORD=Admin@123

# Local development: keep False. On HTTPS hosting, set True.
SESSION_COOKIE_SECURE=False

# Flask debug mode (1 = on, 0 = off)
FLASK_DEBUG=0
